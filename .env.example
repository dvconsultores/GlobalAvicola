# ============================================================
# Global Avícola — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values
# ============================================================

# ----- General -----
ENVIRONMENT=development
PROJECT_NAME=global-avicola
DEBUG=true

# ----- Backend -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8002
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:3005,https://avicola.globaldv.net

# ----- Database (PostgreSQL) -----
# ⚠️ DESARROLLO: Base de datos en la nube
# Cuando recibas las credenciales, completa los valores abajo
# y copia este archivo a .env
POSTGRES_HOST=<HOST_DEL_SERVIDOR>
POSTGRES_PORT=5432
POSTGRES_DB=global_avicola
POSTGRES_USER=<USUARIO>
POSTGRES_PASSWORD=<CONTRASEÑA>
# La URL se construye automáticamente:
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Si la BD requiere SSL (nube):
# DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?ssl=require

# ----- JWT Authentication -----
JWT_SECRET_KEY=change_me_to_a_secure_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- Frontend -----
FRONTEND_PORT=3005
VITE_API_URL=http://localhost:8002/api/v1
VITE_APP_NAME=Global Avícola

# ----- SAP Integration (future) -----
SAP_ENABLED=false
SAP_INTEGRATION_MODE=manual
# SAP_API_URL=
# SAP_USERNAME=
# SAP_PASSWORD=
# SAP_CLIENT=

# ----- Email (future) -----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@globalavicola.com

# ----- Logging -----
LOG_LEVEL=INFO
LOG_FORMAT=json
