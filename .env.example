# ============================================================
# Global Avícola — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values
# ============================================================

# ----- General -----
ENVIRONMENT=development
PROJECT_NAME=global-avicola
DEBUG=true

# ----- Backend -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173

# ----- Database (PostgreSQL) -----
# ⚠️ DESARROLLO: Base de datos en la nube
# Cuando recibas las credenciales, completa los valores abajo
# y copia este archivo a .env
POSTGRES_HOST=<HOST_DEL_SERVIDOR>
POSTGRES_PORT=5432
POSTGRES_DB=global_avicola
POSTGRES_USER=<USUARIO>
POSTGRES_PASSWORD=<CONTRASEÑA>
# La URL se construye automáticamente:
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Si la BD requiere SSL (nube):
# DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?ssl=require

# ----- JWT -----
# Genera uno seguro con: python -c 'import secrets; print(secrets.token_hex(32))'
JWT_SECRET_KEY=change_me_generate_a_secure_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# Feature Flags (DESARROLLO)
# ============================================================
# Activar cuando tengas SAP disponible para pruebas
FEATURE_SAP_ENABLED=false

# Activar cuando quieras probar rate limiting
FEATURE_RATE_LIMIT_ENABLED=false

# Auditoría siempre activa
FEATURE_AUDIT_ENABLED=true

# Review/Approval workflow
FEATURE_REVIEW_ENABLED=true

# ============================================================
# PRODUCCIÓN — Activar antes de subir:
# ============================================================
# FEATURE_SAP_ENABLED=true
# FEATURE_RATE_LIMIT_ENABLED=true
# ENVIRONMENT=production
# DEBUG=false

# ----- JWT Authentication -----
JWT_SECRET_KEY=change_me_to_a_secure_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- Frontend -----
FRONTEND_PORT=3005
VITE_API_URL=http://localhost:8002/api/v1
VITE_APP_NAME=Global Avícola

# ----- SAP Integration (future) -----
SAP_ENABLED=false
SAP_INTEGRATION_MODE=manual
# SAP_API_URL=
# SAP_USERNAME=
# SAP_PASSWORD=
# SAP_CLIENT=

# ----- Email (future) -----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@globalavicola.com

# ----- Logging -----
LOG_LEVEL=INFO
LOG_FORMAT=json
