# ============================================================
# Global Avícola — Environment Variables (PLANTILLA)
# ============================================================
# Copia este archivo a .env y completa los valores REALES ahí.
# ⚠️ NUNCA pongas contraseñas/secretos reales en este archivo:
#    .env.example se sube a git y quedaría expuesto en el historial.
#    Los valores reales van SOLO en .env (que está en .gitignore).
# ============================================================

# ----- General -----
ENVIRONMENT=development
PROJECT_NAME=global-avicola
DEBUG=true

# ----- Backend -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8002
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:3005,https://avicola.globaldv.net

# ----- Database (PostgreSQL) -----
# Completa con las credenciales reales en tu .env.
POSTGRES_HOST=<HOST_DEL_SERVIDOR>
POSTGRES_PORT=5432
POSTGRES_DB=<NOMBRE_BD>
POSTGRES_USER=<USUARIO>
POSTGRES_PASSWORD=<CONTRASEÑA>
# En .env usa la cadena COMPLETA ya expandida (Docker Compose no
# expande ${VAR} dentro de env_file). Ejemplo:
# DATABASE_URL=postgresql+asyncpg://usuario:contrasena@host:5432/nombre_bd
DATABASE_URL=postgresql+asyncpg://<USUARIO>:<CONTRASEÑA>@<HOST_DEL_SERVIDOR>:5432/<NOMBRE_BD>
# Si la BD requiere SSL (nube), añade al final: ?ssl=require

# ----- JWT Authentication -----
# Genera uno seguro con: python -c 'import secrets; print(secrets.token_hex(32))'
JWT_SECRET_KEY=change_me_generate_a_secure_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# Feature Flags
# ============================================================
# DESARROLLO (valores por defecto):
FEATURE_SAP_ENABLED=false
FEATURE_RATE_LIMIT_ENABLED=false
FEATURE_AUDIT_ENABLED=true
FEATURE_REVIEW_ENABLED=true
# PRODUCCIÓN — activar antes de subir:
# FEATURE_SAP_ENABLED=true
# FEATURE_RATE_LIMIT_ENABLED=true
# ENVIRONMENT=production
# DEBUG=false

# ----- Frontend -----
FRONTEND_PORT=3005
VITE_API_URL=http://localhost:8002/api/v1
VITE_APP_NAME=Global Avícola

# ----- SAP Integration (futuro) -----
SAP_ENABLED=false
SAP_INTEGRATION_MODE=manual
# SAP_API_URL=
# SAP_USERNAME=
# SAP_PASSWORD=
# SAP_CLIENT=

# ----- SAP HANA Cloud · inbound READ ONLY (SPEC 005) -----
# Sin estos valores el backend arranca igual; la integración queda en PENDING_CREDENTIALS.
# El usuario técnico debe ser READ ONLY en SAP. Los valores reales van SOLO en el .env del
# servidor: nunca en el repositorio, en la documentación ni en los logs.
SAP_HANA_HOST=
SAP_HANA_PORT=443
SAP_HANA_USER=
SAP_HANA_PASSWORD=
SAP_HANA_SCHEMA=
# Mandante (MANDT).
SAP_HANA_CLIENT=
# TLS obligatorio. Poner cualquiera a false NO lo desactiva: el conector rechaza conectar.
SAP_HANA_ENCRYPT=true
SAP_HANA_SSL_VALIDATE_CERTIFICATE=true
# Ruta a la CA del endpoint, solo si exige una propia (añade confianza, no quita validación).
SAP_HANA_SSL_TRUST_STORE=
SAP_HANA_CONNECT_TIMEOUT_SECONDS=10
SAP_HANA_QUERY_TIMEOUT_SECONDS=60
SAP_HANA_PAGE_SIZE=500
SAP_HANA_MAX_ROWS_PER_SYNC=20000
SAP_HANA_DEFAULT_LOOKBACK_DAYS=30
# Sincronización programada: apagada hasta completar el probe real.
SAP_HANA_SYNC_ENABLED=false
SAP_HANA_SYNC_INTERVAL_SECONDS=3600
# Listas de admisión opcionales, separadas por comas. Solo restringen el mapping.
SAP_HANA_COMPANY_CODES=
SAP_HANA_PLANTS=
SAP_HANA_LANGUAGE=S
# hdbcli = driver oficial. "fake" solo se admite con ENVIRONMENT=development|test.
SAP_HANA_DRIVER=hdbcli
# Fase 1 = solo lectura: el envío a SAP queda deshabilitado (409 en /sap/export y /sap/retry).
SAP_OUTBOUND_ENABLED=false

# ----- Email (futuro) -----
# Completa con credenciales reales SOLO en tu .env.
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=587
SMTP_USER=<SMTP_USER>
SMTP_PASSWORD=<SMTP_PASSWORD>
EMAIL_FROM=noreply@globalavicola.com

# ----- Logging -----
LOG_LEVEL=INFO
LOG_FORMAT=json


# ---- Telegram Bot ----
TELEGRAM_API_KEY=<TELEGRAM_API_KEY>
TELEGRAM_MINI_APP_URL=https://avicola.globaldv.net
