# .gitignore — Global Avícola

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
eggs/
*.egg
.env
.venv/
venv/
env/

# ===== Node.js =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== Build =====
frontend/dist/
frontend/dist-ssr/
backend/dist/
.vite/
.turbo/

# ===== Environment Variables (Local Development) =====
.env
.env.local
.env.*.local
!.env.example
!.env.*.example
/frontend/.env
/frontend/.env.local
/frontend/.env.*.local

# ===== IDE =====
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json

# ===== Docker =====
.docker/

# ===== Testing & E2E =====
.coverage
htmlcov/
.pytest_cache/
coverage.xml
playwright-report/
test-results/
/frontend/playwright-report/
/frontend/test-results/
/frontend/.playwrightrc.js
/frontend/videos/
/frontend/test-artifacts/
/frontend/.nyc_output/
/frontend/coverage/

# ===== Database =====
*.db
*.sqlite3
pgdata/

# ===== Logs =====
*.log
logs/
/frontend/*.log
/backend/*.log

# ===== Misc & Temporary Files =====
*.tmp
*.bak
.cache/
/frontend/.cache/
/frontend/.parcel-cache/
/backend/.cache/

# ===== Development Artifacts =====
/frontend/tsconfig.tsbuildinfo
/backend/*.egg-info
